[Unit]
Description=Nutshell Cashu walletd (UDS)
After=network.target
Wants=network.target

[Service]
Type=simple

# Run as the separate nutshell user, with the cashu group for socket ACLs
User=nutshell
Group=cashu

# Ensure /run/cashu exists with the required ownership + mode
RuntimeDirectory=cashu
RuntimeDirectoryMode=0750

# Ensure the socket ends up 0660 (uvicorn uses process umask when creating it)
UMask=0007

# Run from the nutshell service home + repo directory
WorkingDirectory=/var/lib/nutshell/nutshell

# Do NOT depend on .profile/.bashrc. Systemd does not run interactive shell init.
Environment=HOME=/var/lib/nutshell
Environment=PYENV_ROOT=/var/lib/nutshell/.pyenv
Environment=PATH=/var/lib/nutshell/.pyenv/shims:/var/lib/nutshell/.pyenv/bin:/var/lib/nutshell/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# If you use pyenv-virtualenv, it is typically not required just to run poetry,
# as long as shims are on PATH.
ExecStart=/bin/bash -c '/var/lib/nutshell/.local/bin/poetry run cashu walletd --uds /run/cashu/walletd.sock'

Restart=always
RestartSec=2

# Optional: tighten systemd sandboxing a bit without breaking file/socket access
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target

