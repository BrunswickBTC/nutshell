[Unit]
Description=Cashu Nutshell Wallet Daemon (UDS)
After=network.target

[Service]
User=cashu
Group=cashu
Environment=CASHU_WALLET_DB=/var/lib/cashu/wallet.sqlite3
Environment=CASHU_DEFAULT_MINT_URL=https://your.default.mint
RuntimeDirectory=cashu
RuntimeDirectoryMode=0750
ExecStart=/usr/local/bin/cashu walletd --uds /run/cashu/walletd.sock
Restart=on-failure

ExecStartPre=/bin/bash -lc 'rm -f /run/cashu/walletd.sock; install -d -m 0750 -o cashu -g lnbits /run/cashu'
ExecStartPost=/bin/bash -lc 'chown cashu:lnbits /run/cashu/walletd.sock; chmod 0660 /run/cashu/walletd.sock'


[Install]
WantedBy=multi-user.target

